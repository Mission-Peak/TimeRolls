// Copy this to Secrets.xcconfig and fill in the values. That file is git-ignored.
//
// These are the `timerolls-readonly` credentials — read-only, scoped to one bucket of
// freely-licensed photographs, verified against the live service as unable to write, to
// delete, or to see any other bucket. That is what makes it defensible to ship them at
// all: anything extracted from the app binary can fetch public photographs and nothing else.
//
// Never put the `timerolls` or `timerolls-upload` credentials here. Those can write.

ONEBUCKET_HOST = s3.onebucket.io
ONEBUCKET_NAME = timerolls-readonly
ONEBUCKET_REGION = us-east-1
ONEBUCKET_ACCESS_KEY_ID =
ONEBUCKET_SECRET_ACCESS_KEY =
